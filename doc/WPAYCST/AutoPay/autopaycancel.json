{
    "serviceDescription": "WPAYPlus 자동결제 해지 요청",
    "uri": "/cst/apis/autopaycancel",
    "method": "POST",
    "request": [
        {
            "name": "mid",
            "type": "String",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "가맹점 ID",
            "length": 10,
            "signingOrder": 1
        },
        {
            "name": "wpayUserKey",
            "type": "String",
            "required": true,
            "encrypt": true,
            "encoded": false,
            "description": "WPAY 사용자 KEY [CI 1:1 매칭]",
            "length": 100,
            "signingOrder": 2
        },
        {
            "name": "ci",
            "type": "String",
            "required": false,
            "encrypt": true,
            "encoded": false,
            "description": "본인인증기관 사용자 고유 식별 값",
            "length": 100,
            "signingOrder": 3
        },
        {
            "name": "wtid",
            "type": "String",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "자동결제 신청 WTID",
            "length": 40,
            "signingOrder": 4
        },
        {
            "name": "signature",
            "type": "String",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "데이터 위변조 검증값",
            "length": 100,
            "signingOrder": null
        }
    ],
    "response": [
        {
            "name": "resultCode",
            "type": "String",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "결과코드",
            "length": 6,
            "signingOrder": null
        },
        {
            "name": "resultMsg",
            "type": "String",
            "required": false,
            "encrypt": false,
            "decoded": true,
            "description": "결과메시지",
            "length": 150,
            "signingOrder": null
        },
        {
            "name": "wtid",
            "type": "String",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "WPAY 트랜잭션 ID",
            "length": 40,
            "signingOrder": null
        }
    ]
}