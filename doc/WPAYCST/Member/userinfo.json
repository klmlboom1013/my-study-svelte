{
    "serviceDescription": "WPAY 회원 상태를 조회한다.",
    "uri": "/cst/apis/userinfo",
    "method": "GET",
    "request": [
        {
            "name": "mid",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "가맹점 ID",
            "length": 10,
            "signingOrder": 1
        },
        {
            "name": "wpayUserKey",
            "type": "string",
            "required": true,
            "encrypt": true,
            "encoded": false,
            "description": "WPAY 사용자 KEY [CI 1:1 매칭]",
            "length": 100,
            "signingOrder": 2
        },
        {
            "name": "ci",
            "type": "string",
            "required": false,
            "encrypt": true,
            "encoded": false,
            "description": "본인인증기관 사용자 고유 식별 값",
            "length": 100,
            "signingOrder": 3
        },
        {
            "name": "signature",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "데이터 위변조 검증값",
            "length": 100,
            "signingOrder": null
        }
    ],
    "response": [
        {
            "name": "resultCode",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "결과코드",
            "length": 6,
            "signingOrder": null
        },
        {
            "name": "resultMsg",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": true,
            "description": "결과메시지",
            "length": 150,
            "signingOrder": null
        },
        {
            "name": "wtid",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "WPAY 트랜잭션 ID",
            "length": 40,
            "signingOrder": null
        },
        {
            "name": "wpayUserKey",
            "type": "string",
            "required": false,
            "encrypt": true,
            "decoded": false,
            "description": "WPAY 사용자 KEY [CI 1:1 매칭]",
            "length": 100,
            "signingOrder": null
        },
        {
            "name": "status",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "상태코드 (00: 정상, 01: 중지, 02: 해지)",
            "length": 2,
            "signingOrder": null
        }
    ]
}