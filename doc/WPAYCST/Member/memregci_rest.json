            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "주민번호 뒤 첫자리",
            "length": 1,
            "signingOrder": 7
        },
        {
            "name": "signature",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "데이터 위변조 검증값",
            "length": 100,
            "signingOrder": null
        }
