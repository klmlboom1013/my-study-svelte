        {
            "name": "mid",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "가맹점 ID",
            "length": 10,
            "signingOrder": 1
        },
        {
            "name": "userId",
            "type": "string",
            "required": true,
            "encrypt": true,
            "encoded": false,
            "description": "가맹점 사용자ID",
            "length": 20,
            "signingOrder": 2
        },
        {
            "name": "ci",
            "type": "string",
            "required": true,
            "encrypt": true,
            "encoded": false,
            "description": "본인인증기관 사용자 고유 식별 값",
            "length": 100,
            "signingOrder": 3
        },
        {
            "name": "userNm",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": true,
            "description": "고객 이름",
            "length": 100,
            "signingOrder": 4
        },
        {
            "name": "hNum",
            "type": "string",
            "required": true,
            "encrypt": true,
            "encoded": false,
            "description": "고객 휴대폰번호 [\"-\" 제외]",
            "length": 100,
            "signingOrder": 5
        },
        {
            "name": "birthDay",
            "type": "string",
            "required": true,
            "encrypt": true,
            "encoded": false,
