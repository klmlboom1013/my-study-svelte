            "encrypt": false,
            "encoded": false,
            "description": "보안 키패드 컬러 [G, D, W]",
            "length": 1,
            "signingOrder": null
        },
        {
            "name": "themeColor",
            "type": "String",
            "required": false,
            "encrypt": false,
            "encoded": true,
            "description": "RGB 색상 코드 (#fdb549)",
            "length": 7,
            "signingOrder": null
        },
        {
            "name": "mid",
            "type": "String",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "가맹점 ID",
