            "signingOrder": null
        },
        {
            "name": "cardnum3",
            "type": "String",
            "required": false,
            "encrypt": false,
            "encoded": false,
            "description": "카드번호 9~12 자리 (appkey로 SEED암호화)",
            "length": 100,
            "signingOrder": null
        },
        {
            "name": "cardnum4",
            "type": "String",
            "required": false,
            "encrypt": false,
            "encoded": false,
            "description": "카드번호 13~16 자리 (appkey로 SEED암호화)",
