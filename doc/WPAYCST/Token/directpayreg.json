{
    "serviceDescription": "WPAY 카드 바로등록(PLCC) 한다.",
    "uri": "/cst/apis/directpayreg",
    "method": "POST",
    "request": [
        {
            "name": "mid",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "가맹점 ID",
            "length": 10,
            "signingOrder": 1
        },
        {
            "name": "wpayUserKey",
            "type": "string",
            "required": true,
            "encrypt": true,
            "encoded": false,
            "description": "WPAY 사용자 KEY [CI 1:1 매칭]",
            "length": 100,
            "signingOrder": 2
        },
        {
            "name": "ci",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "고객CI 정보",
            "length": 100,
            "signingOrder": 3
        },
        {
            "name": "bankCardCode",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "카드사 코드",
            "length": 4,
            "signingOrder": 4
        },
        {
            "name": "cardRegKey",
            "type": "string",
            "required": true,
            "encrypt": true,
            "encoded": false,
            "description": "카드등록KEY",
            "length": 100,
            "signingOrder": 5
        },
        {
            "name": "signature",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "데이터 위변조 검증값",
            "length": 100,
            "signingOrder": null
        }
    ],
    "response": [
        {
            "name": "resultCode",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "결과코드",
            "length": 6,
            "signingOrder": null
        },
        {
            "name": "resultMsg",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": true,
            "description": "결과메시지",
            "length": 150,
            "signingOrder": null
        },
        {
            "name": "wtid",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "WPAY 트랜잭션 ID",
            "length": 40,
            "signingOrder": null
        },
        {
            "name": "wpayUserKey",
            "type": "string",
            "required": false,
            "encrypt": true,
            "decoded": false,
            "description": "WPAY 사용자 KEY [CI 1:1 매칭]",
            "length": 100,
            "signingOrder": null
        },
        {
            "name": "wpayToken",
            "type": "string",
            "required": false,
            "encrypt": true,
            "decoded": false,
            "description": "결제수단 WPAY Token",
            "length": 100,
            "signingOrder": null
        },
        {
            "name": "bankCardCode",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "카드사 코드",
            "length": 4,
            "signingOrder": null
        },
        {
            "name": "bankCardNo",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "마스킹 카드 번호",
            "length": 40,
            "signingOrder": null
        },
        {
            "name": "checkFlg",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "카드유형 [0:신용, 1:체크, 2:선불]",
            "length": 1,
            "signingOrder": null
        },
        {
            "name": "cardTypeFlg",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "개인/법카 구분",
            "length": 1,
            "signingOrder": null
        },
        {
            "name": "cardPdNum",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "카드 상품번호",
            "length": 20,
            "signingOrder": null
        },
        {
            "name": "cardBImgUrl",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": true,
            "description": "카드 상품 이미지 URL",
            "length": 100,
            "signingOrder": null
        },
        {
            "name": "cardName",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": true,
            "description": "카드 브랜드 명",
            "length": 100,
            "signingOrder": null
        }
    ]
}