{
    "serviceDescription": "WPAY 토큰을 통해 신용카드 결제 인증 요청을 한다.",
    "uri": "/cst/u/payreqauth",
    "method": "POST",
    "request": [
        {
            "name": "mid",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "가맹점 ID(Merchant ID)",
            "length": 10,
            "signingOrder": 1
        },
        {
            "name": "wpayUserKey",
            "type": "string",
            "required": true,
            "encrypt": true,
            "encoded": false,
            "description": "WPAY 사용자 KEY [CI 1:1 매칭]",
            "length": 100,
            "signingOrder": 2
        },
        {
            "name": "wpayToken",
            "type": "string",
            "required": true,
            "encrypt": true,
            "encoded": false,
            "description": "이니시스에서 발행한 토큰",
            "length": 100,
            "signingOrder": 3
        },
        {
            "name": "ci",
            "type": "string",
            "required": false,
            "encrypt": true,
            "encoded": false,
            "description": "본인인증기관 사용자 고유 식별 값",
            "length": 100,
            "signingOrder": 4
        },
        {
            "name": "payMethod",
            "type": "string",
            "required": false,
            "encrypt": false,
            "encoded": false,
            "description": "결제수단 코드 [01:신용카드]",
            "length": 2,
            "signingOrder": 5
        },
        {
            "name": "bankCardCode",
            "type": "string",
            "required": false,
            "encrypt": false,
            "encoded": false,
            "description": "신용카드: 5.2 카드사 코드 참조",
            "length": 4,
            "signingOrder": 6
        },
        {
            "name": "oid",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "주문번호",
            "length": 100,
            "signingOrder": 7
        },
        {
            "name": "goodsName",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": true,
            "description": "상품명",
            "length": 255,
            "signingOrder": 8
        },
        {
            "name": "goodsPrice",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "결제금액",
            "length": 10,
            "signingOrder": 9
        },
        {
            "name": "buyerName",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": true,
            "description": "구매자명",
            "length": 100,
            "signingOrder": 10
        },
        {
            "name": "buyerTel",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "구매자연락처",
            "length": 100,
            "signingOrder": 11
        },
        {
            "name": "buyerEmail",
            "type": "string",
            "required": false,
            "encrypt": false,
            "encoded": false,
            "description": "구매자이메일",
            "length": 100,
            "signingOrder": 12
        },
        {
            "name": "cardQuota",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "할부개월수(00:일시불)",
            "length": 2,
            "signingOrder": 13
        },
        {
            "name": "cardInterest",
            "type": "string",
            "required": false,
            "encrypt": false,
            "encoded": false,
            "description": "무이자여부(Y/N)",
            "length": 1,
            "signingOrder": 14
        },
        {
            "name": "couponCode",
            "type": "string",
            "required": false,
            "encrypt": true,
            "encoded": false,
            "description": "선할인 쿠폰코드",
            "length": 20,
            "signingOrder": 15
        },
        {
            "name": "flagPin",
            "type": "string",
            "required": false,
            "encrypt": false,
            "encoded": false,
            "description": "고정값 Y 또는 null",
            "length": 1,
            "signingOrder": 16
        },
        {
            "name": "flagPinMsg",
            "type": "string",
            "required": false,
            "encrypt": false,
            "encoded": true,
            "description": "핀인증 창 안내 메시지",
            "length": 256,
            "signingOrder": 17
        },
        {
            "name": "returnUrl",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": true,
            "description": "결과 전달 받을 Callback URL",
            "length": 256,
            "signingOrder": 18
        },
        {
            "name": "signature",
            "type": "string",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "데이터 위변조 검증값",
            "length": 100,
            "signingOrder": null
        }
    ],
    "response": [
        {
            "name": "resultCode",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "결과코드",
            "length": 6,
            "signingOrder": 1
        },
        {
            "name": "resultMsg",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": true,
            "description": "결과메시지",
            "length": 150,
            "signingOrder": 2
        },
        {
            "name": "wtid",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "WPAY 트랜잭션 ID",
            "length": 40,
            "signingOrder": 3
        },
        {
            "name": "wpayUserKey",
            "type": "string",
            "required": false,
            "encrypt": true,
            "decoded": false,
            "description": "WPAY 사용자 KEY [CI 1:1 매칭]",
            "length": 100,
            "signingOrder": 4
        },
        {
            "name": "wpayToken",
            "type": "string",
            "required": false,
            "encrypt": true,
            "decoded": false,
            "description": "결제수단 WPAY Token",
            "length": 100,
            "signingOrder": 5
        },
        {
            "name": "fdsResult",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "FDS결제인증 결과",
            "length": 10,
            "signingOrder": 6
        },
        {
            "name": "wpayDomain",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": true,
            "description": "결제승인 혹은 망취소 요청 시 사용",
            "length": 30,
            "signingOrder": 7
        },
        {
            "name": "signature",
            "type": "string",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "데이터 위변조 검증값",
            "length": 100,
            "signingOrder": null
        }
    ]
}