            "length": 40,
            "signingOrder": 4
        },
        {
            "name": "returnUrl",
            "type": "String",
            "required": true,
            "encrypt": false,
            "encoded": true,
            "description": "결과 전달 받을 Callback URL",
            "length": 256,
            "signingOrder": null
        },
        {
            "name": "signature",
            "type": "String",
            "required": true,
            "encrypt": false,
            "encoded": false,
            "description": "데이터 위변조 검증값",
            "length": 100,
            "signingOrder": null
        }
    ],
    "response": [
        {
