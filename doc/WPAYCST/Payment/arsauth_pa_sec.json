            "name": "wpayUserKey",
            "type": "String",
            "required": false,
            "encrypt": true,
            "decoded": false,
            "description": "이니시스에서 발행한 wpayUserKey",
            "length": 100,
            "signingOrder": null
        },
        {
            "name": "signature",
            "type": "String",
            "required": false,
            "encrypt": false,
            "decoded": false,
            "description": "데이터 위변조 검증값",
            "length": 100,
            "signingOrder": null
