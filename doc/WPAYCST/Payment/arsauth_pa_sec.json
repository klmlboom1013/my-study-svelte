            "encrypt": false,
            "encoded": false,
            "description": "가맹점 ID",
            "length": 10,
            "signingOrder": 1
        },
        {
            "name": "wpayUserKey",
            "type": "String",
            "required": true,
            "encrypt": true,
            "encoded": false,
            "description": "WPAY 사용자 KEY [CI 1:1 매칭]",
            "length": 100,
            "signingOrder": 2
        },
        {
            "name": "ci",
            "type": "String",
            "required": false,
            "encrypt": true,
            "encoded": false,
            "description": "본인인증기관 사용자 고유 식별 값",
            "length": 100,
            "signingOrder": 3
        },
        {
            "name": "hNum",
            "type": "String",
            "required": false,
            "encrypt": true,
            "encoded": false,
            "description": "ARS인증 진행을 위한",
            "length": 100,
            "signingOrder": null
        },
        {
            "name": "wtid",
            "type": "String",
            "required": true,
            "encrypt": false,
            "encoded": false,
